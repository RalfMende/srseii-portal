#!/bin/sh

# Minimal CGI endpoint for portal status data.

set -eu

echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo ""

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

bool_from_rc() {
	if [ "$1" -eq 0 ]; then
		printf 'true'
	else
		printf 'false'
	fi
}

is_pkg_installed() {
	opkg status "$1" 2>/dev/null | grep -q '^Status: .* installed$'
}

service_process_running() {
	service_name="$1"

	if command -v pgrep >/dev/null 2>&1; then
		if pgrep -f "$service_name" >/dev/null 2>&1; then
			return 0
		fi
	fi

	if command -v ps >/dev/null 2>&1; then
		if ps 2>/dev/null | grep -E "[${service_name%${service_name#?}}]${service_name#?}" >/dev/null 2>&1; then
			return 0
		fi
	fi

	return 1
}

service_status_from_ubus() {
	service_name="$1"

	if ! command -v ubus >/dev/null 2>&1; then
		return 2
	fi

	service_list="$(ubus call service list 2>/dev/null || true)"
	[ -n "$service_list" ] || return 2

	if printf '%s' "$service_list" | grep -q "\"$service_name\""; then
		if printf '%s' "$service_list" | grep -Eiq "\"$service_name\".*\"running\"[[:space:]]*:[[:space:]]*true|\"running\"[[:space:]]*:[[:space:]]*true.*\"$service_name\""; then
			return 0
		fi
		if printf '%s' "$service_list" | grep -Eiq "\"$service_name\".*\"running\"[[:space:]]*:[[:space:]]*false|\"running\"[[:space:]]*:[[:space:]]*false.*\"$service_name\""; then
			return 1
		fi
		if printf '%s' "$service_list" | grep -Eiq "\"$service_name\".*\"enabled\"[[:space:]]*:[[:space:]]*true|\"enabled\"[[:space:]]*:[[:space:]]*true.*\"$service_name\""; then
			return 0
		fi
	fi

	return 2
}

is_service_running() {
	service_name="$1"

	if service_process_running "$service_name"; then
		return 0
	fi

	if [ -x "/etc/init.d/$service_name" ]; then
		output="$('/etc/init.d/$service_name' running 2>&1 || true)"
		if printf '%s' "$output" | grep -Eiq 'running|started|active|pid'; then
			return 0
		fi
		if printf '%s' "$output" | grep -Eiq 'not running|stopped|inactive|failed|disabled'; then
			return 1
		fi

		output="$('/etc/init.d/$service_name' status 2>&1 || true)"
		if printf '%s' "$output" | grep -Eiq 'running|started|active|pid'; then
			return 0
		fi
		if printf '%s' "$output" | grep -Eiq 'not running|stopped|inactive|failed|disabled'; then
			return 1
		fi
	fi

	service_status_from_ubus "$service_name"
	status_rc=$?
	if [ "$status_rc" -eq 0 ]; then
		return 0
	fi
	if [ "$status_rc" -eq 1 ]; then
		return 1
	fi

	return 1
}

hostname_value="$(uci -q get system.@system[0].hostname 2>/dev/null || true)"
[ -n "$hostname_value" ] || hostname_value="$(uname -n 2>/dev/null || true)"
[ -n "$hostname_value" ] || hostname_value="unknown"

model_value="$(cat /tmp/sysinfo/model 2>/dev/null || true)"
if [ -z "$model_value" ] && command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
	board_json="$(ubus call system board 2>/dev/null || true)"
	if [ -n "$board_json" ]; then
		model_value="$(printf '%s' "$board_json" | jsonfilter -e '@.model' 2>/dev/null || true)"
	fi
fi
[ -n "$model_value" ] || model_value="unknown"

get_interface_ipv4() {
	iface_name="$1"
	ip -o -4 addr show dev "$iface_name" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1 || true
}

get_ubus_interface_ipv4() {
	target_interface="$1"

	if ! command -v ubus >/dev/null 2>&1 || ! command -v jsonfilter >/dev/null 2>&1; then
		printf ''
		return
	fi

	status_json="$(ubus call network.interface."$target_interface" status 2>/dev/null || true)"
	if [ -z "$status_json" ]; then
		printf ''
		return
	fi

	printf '%s' "$status_json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || true
}

get_wwan_ssid() {
	if ! command -v ubus >/dev/null 2>&1 || ! command -v jsonfilter >/dev/null 2>&1; then
		printf ''
		return
	fi

	wwan_status_json="$(ubus call network.interface.wwan status 2>/dev/null || true)"
	if [ -z "$wwan_status_json" ]; then
		printf ''
		return
	fi

	ssid_candidate="$(printf '%s' "$wwan_status_json" | jsonfilter -e '@.data.ssid' 2>/dev/null || true)"
	[ -n "$ssid_candidate" ] || ssid_candidate="$(printf '%s' "$wwan_status_json" | jsonfilter -e '@.ssid' 2>/dev/null || true)"

	printf '%s' "$ssid_candidate"
}

lan_up=false
lan_ip=""
if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
	if_dump="$(ubus call network.interface dump 2>/dev/null || true)"
	if [ -n "$if_dump" ]; then
		lan_flag="$(printf '%s' "$if_dump" | jsonfilter -e '@.interface[@.interface="lan"].up' 2>/dev/null || true)"
		if [ "$lan_flag" = "true" ]; then
			lan_up=true
		fi
	fi
fi
if [ "$lan_up" = false ]; then
	ip -4 addr show br-lan 2>/dev/null | grep -q 'inet ' && lan_up=true
fi
lan_ip="$(get_ubus_interface_ipv4 lan)"
[ -n "$lan_ip" ] || lan_ip="$(get_interface_ipv4 br-lan)"

wifi_up=false
ssid_value=""
wifi_ip=""
wifi_iface=""
wwan_up=false

if command -v iw >/dev/null 2>&1; then
	interfaces="$(iw dev 2>/dev/null | awk '/^\s*Interface /{print $2}' || true)"
	for iface in $interfaces; do
		if iw dev "$iface" link 2>/dev/null | grep -q 'Connected to'; then
			wifi_up=true
			wifi_iface="$iface"
			ssid_value="$(iw dev "$iface" link 2>/dev/null | awk -F': ' '/SSID:/ {print $2; exit}')"
			break
		fi
	done
fi

if [ -z "$ssid_value" ] && [ -n "$wifi_iface" ] && command -v iw >/dev/null 2>&1; then
	ssid_value="$(iw dev "$wifi_iface" link 2>/dev/null | awk -F': ' '/SSID:/ {print $2; exit}')"
fi

if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
	wwan_status="$(ubus call network.interface.wwan status 2>/dev/null || true)"
	if [ -n "$wwan_status" ]; then
		wwan_flag="$(printf '%s' "$wwan_status" | jsonfilter -e '@.up' 2>/dev/null || true)"
		if [ "$wwan_flag" = "true" ]; then
			wwan_up=true
			wifi_up=true
		fi
	fi

	if [ -z "$ssid_value" ] && [ "$wifi_up" = true ]; then
		ssid_value="$(get_wwan_ssid)"
	fi
fi
[ -n "$wifi_iface" ] || wifi_iface="$(uci -q get wireless.@wifi-iface[0].ifname 2>/dev/null || true)"
[ -n "$wifi_iface" ] || wifi_iface="wlan0"
[ -n "$wifi_ip" ] || wifi_ip="$(get_ubus_interface_ipv4 wwan)"
[ -n "$wifi_ip" ] || wifi_ip="$(get_interface_ipv4 "$wifi_iface")"

if [ -n "$wifi_ip" ] && [ "$wifi_up" = false ]; then
	wifi_up=true
fi

if [ "$wifi_up" = false ]; then
	ssid_value="nicht verbunden"
	wifi_ip=""
fi

[ -n "$ssid_value" ] || ssid_value="unbekannt"

ip_value="$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1 || true)"
[ -n "$ip_value" ] || ip_value="nicht verfügbar"

primary_ip="$lan_ip"
if [ -z "$primary_ip" ]; then
	primary_ip="$wifi_ip"
fi
[ -n "$primary_ip" ] || primary_ip="$ip_value"
[ -n "$primary_ip" ] || primary_ip="nicht verfügbar"

status_message="Keine aktive Netzwerkverbindung."
if [ "$lan_up" = true ] || [ "$wifi_up" = true ]; then
	if [ "$primary_ip" = "nicht verfügbar" ]; then
		status_message="Verbindung vorhanden, aber keine IP-Adresse gefunden."
	else
		status_message="Netzwerkverbindung verfügbar."
	fi
fi

mswebapp_pkg_rc=1
if is_pkg_installed mswebapp; then
	mswebapp_pkg_rc=0
fi

mswebapp_service_rc=1
if is_service_running mswebapp; then
	mswebapp_service_rc=0
fi

railcontrol_pkg_rc=1
if is_pkg_installed railcontrol; then
	railcontrol_pkg_rc=0
fi

railcontrol_service_rc=1
if is_service_running railcontrol; then
	railcontrol_service_rc=0
fi

z21emu_service_rc=1
if is_service_running z21emu; then
	z21emu_service_rc=0
fi

can2lan_service_rc=1
if is_service_running can2lan; then
	can2lan_service_rc=0
fi

clone_ms2_loco_service_rc=1
if is_service_running clone-ms2-loco; then
	clone_ms2_loco_service_rc=0
fi

maecanserver_service_rc=1
if is_service_running maecanserver; then
	maecanserver_service_rc=0
fi

ms2_loco_list_service_rc=1
if is_service_running ms2-loco-list; then
	ms2_loco_list_service_rc=0
fi

wake_up_links88_service_rc=1
if is_service_running wake-up-links88; then
	wake_up_links88_service_rc=0
fi

mswebapp_ready_rc=1
if [ "$mswebapp_pkg_rc" -eq 0 ] && [ "$mswebapp_service_rc" -eq 0 ] && [ "$can2lan_service_rc" -eq 0 ] && [ "$clone_ms2_loco_service_rc" -eq 0 ]; then
	mswebapp_ready_rc=0
fi

railcontrol_ready_rc=1
if [ "$railcontrol_pkg_rc" -eq 0 ] && [ "$railcontrol_service_rc" -eq 0 ] && [ "$can2lan_service_rc" -eq 0 ] && [ "$clone_ms2_loco_service_rc" -eq 0 ]; then
	railcontrol_ready_rc=0
fi

mswebapp_pkg_value="$(bool_from_rc "$mswebapp_pkg_rc")"
mswebapp_service_value="$(bool_from_rc "$mswebapp_service_rc")"
mswebapp_ready_value="$(bool_from_rc "$mswebapp_ready_rc")"
railcontrol_pkg_value="$(bool_from_rc "$railcontrol_pkg_rc")"
railcontrol_service_value="$(bool_from_rc "$railcontrol_service_rc")"
railcontrol_ready_value="$(bool_from_rc "$railcontrol_ready_rc")"
z21emu_service_value="$(bool_from_rc "$z21emu_service_rc")"
can2lan_service_value="$(bool_from_rc "$can2lan_service_rc")"
clone_ms2_loco_service_value="$(bool_from_rc "$clone_ms2_loco_service_rc")"
maecanserver_service_value="$(bool_from_rc "$maecanserver_service_rc")"
ms2_loco_list_service_value="$(bool_from_rc "$ms2_loco_list_service_rc")"
wake_up_links88_service_value="$(bool_from_rc "$wake_up_links88_service_rc")"

cat <<EOF
{"hostname":"$(json_escape "$hostname_value")","model":"$(json_escape "$model_value")","network":{"lan":$lan_up,"wifi":$wifi_up,"ssid":"$(json_escape "$ssid_value")","ip":"$(json_escape "$primary_ip")","lanIp":"$(json_escape "$lan_ip")","wifiIp":"$(json_escape "$wifi_ip")","wifiInterface":"$(json_escape "$wifi_iface")","message":"$(json_escape "$status_message")"},"apps":{"mswebapp":$mswebapp_ready_value,"railcontrol":$railcontrol_ready_value},"services":{"mswebapp":$mswebapp_service_value,"railcontrol":$railcontrol_service_value,"z21emu":$z21emu_service_value,"can2lan":$can2lan_service_value,"clone-ms2-loco":$clone_ms2_loco_service_value,"maecanserver":$maecanserver_service_value,"ms2-loco-list":$ms2_loco_list_service_value,"wake-up-links88":$wake_up_links88_service_value}}
EOF
