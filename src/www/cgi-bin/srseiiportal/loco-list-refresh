#!/bin/sh

set -u

CAN_INTERFACE="${SRSEII_CAN_INTERFACE:-can0}"
CAN_ID="000C0300"
CAN_DATA_UPDATE="000000010001"
CAN_DATA_RESET="000000010004"

json_escape() {
	printf '%s' "$1" | tr '\r\n' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_response() {
	response_ok="$1"
	response_status="$2"
	response_message="$3"
	response_message_de="$4"

	printf 'Content-Type: application/json\n'
	printf 'Cache-Control: no-store\n'
	printf '\n'
	printf '{"ok":%s,"status":"%s","message":"%s","messageDe":"%s"}\n' \
		"$response_ok" \
		"$(json_escape "$response_status")" \
		"$(json_escape "$response_message")" \
		"$(json_escape "$response_message_de")"
}

if [ "${REQUEST_METHOD:-GET}" != "GET" ]; then
	json_response false "error" "Only read access is supported." "Nur Lesezugriff wird unterstützt."
	exit 0
fi

action=""
case "${QUERY_STRING:-}" in
	*action=update*) action="update" ;;
	*action=reset*) action="reset" ;;
esac

case "$action" in
	update) can_frame="${CAN_ID}#${CAN_DATA_UPDATE}" ;;
	reset) can_frame="${CAN_ID}#${CAN_DATA_RESET}" ;;
	*)
		json_response false "error" "Unknown or missing action." "Unbekannte oder fehlende Aktion."
		exit 0
		;;
esac

if ! command -v cansend >/dev/null 2>&1; then
	json_response false "error" "cansend is not available on this system." "cansend ist auf diesem System nicht verfügbar."
	exit 0
fi

can_error_file="/tmp/srseii-loco-list-refresh.$$.err"
trap 'rm -f "$can_error_file"' EXIT

if ! cansend "$CAN_INTERFACE" "$can_frame" 2>"$can_error_file"; then
	can_error="$(cat "$can_error_file" 2>/dev/null || true)"
	json_response false "error" "Sending the CAN command failed: ${can_error}" "Senden des CAN-Befehls ist fehlgeschlagen: ${can_error}"
	exit 0
fi

if [ "$action" = "update" ]; then
	json_response true "ok" "Locomotive list update requested." "Aktualisierung der Lokliste angefordert."
else
	json_response true "ok" "Locomotive list reset requested." "Zurücksetzen der Lokliste angefordert."
fi
