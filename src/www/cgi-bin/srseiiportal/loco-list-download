#!/bin/sh

set -eu

if [ "${REQUEST_METHOD:-GET}" != "GET" ]; then
	echo "Status: 405 Method Not Allowed"
	echo "Content-Type: text/plain"
	echo ""
	printf 'Only read access is supported.\n'
	exit 0
fi

list_file=""
for candidate in \
	/www/config/lokomotive.cs2 \
	/var/lokomotive.cs2 \
	/tmp/lokomotive.cs2; do
	if [ -f "$candidate" ] && [ -r "$candidate" ]; then
		list_file="$candidate"
		break
	fi
done

if [ -z "$list_file" ]; then
	echo "Status: 404 Not Found"
	echo "Content-Type: text/plain"
	echo ""
	printf 'No locomotive list is available.\n'
	exit 0
fi

echo "Content-Type: application/octet-stream"
echo "Content-Disposition: attachment; filename=\"lokomotive.cs2\""
echo "Cache-Control: no-store"
echo ""
cat "$list_file"